# Production Environment Configuration
# Copy this file to .env and fill in all required values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# HTTP Server Port (default: 3001)
PORT=3001

# Node environment (production, development)
NODE_ENV=production

# Public URL where the app is hosted
PUBLIC_URL=https://scoreboard.ussyco.de

# JWT secret for token signing (REQUIRED in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long

# PostgreSQL database connection string (REQUIRED)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://scoreboard:password@localhost:5432/scoreboard?schema=public

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Redis connection string (optional but recommended for production)
# Enables Socket.IO multi-instance synchronization
REDIS_URL=redis://localhost:6379

# Logging level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Room configuration
ROOM_TTL_HOURS=2
MAX_ROOMS=100

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS origins (comma-separated, defaults to PUBLIC_URL)
# CORS_ORIGINS=https://scoreboard.ussyco.de,https://admin.scoreboard.ussyco.de
