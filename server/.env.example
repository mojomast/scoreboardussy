# Server configuration (copy to .env and adjust for your environment)
# Server configuration (copy to .env and adjust for your environment)

# HTTP
PORT=3001
NODE_ENV=development
PUBLIC_URL=https://scoreboard.ussy.host

# JWT secret for token signing (change in production!)
JWT_SECRET=your-secret-key-here

# Room configuration
ROOM_TTL_HOURS=2
MAX_ROOMS=100

# Database (PostgreSQL required for persistence)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://app:example@localhost:5432/improvscoreboard?schema=public

# Redis (optional, enables horizontal scaling via Socket.IO Redis adapter)
# REDIS_URL=redis://localhost:6379
